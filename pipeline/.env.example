# NewsAPI key — https://newsapi.org/register
NEWSAPI_KEY=

# Finnhub key — https://finnhub.io/register
FINNHUB_KEY=

# LLM provider for cluster briefings: gemini (default) | anthropic | deepseek
LLM_PROVIDER=gemini

# Gemini key — https://aistudio.google.com/apikey (free tier, no card)
GEMINI_API_KEY=

# Alternate providers — only needed if LLM_PROVIDER is set to them
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Optional: override output directory (default: ../content/digests)
# DIGESTS_DIR=../content/digests
